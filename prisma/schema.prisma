// ============================================================
// NTEMTEM DEALS — Prisma Schema
// Ghana e-commerce platform (China-sourced, pre-order model)
// Stack: Next.js 16 + Prisma + Supabase (PostgreSQL)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// USERS — customers and admins
// ------------------------------------------------------------
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String?   // optional: guest-converted accounts may not set one immediately
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders    Order[]
  addresses Address[]
  cart      Cart?
}

enum Role {
  CUSTOMER
  ADMIN
}

// ------------------------------------------------------------
// CATEGORY — product groupings (fashion, electronics, home, etc.)
// Flexible: client creates his own categories in the admin
// ------------------------------------------------------------
model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  image        String?   // Cloudinary URL — category banner
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  products Product[]
}

// ------------------------------------------------------------
// PRODUCT — the items for sale
// ------------------------------------------------------------
model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String    @db.Text
  categoryId       String
  price            Decimal   @db.Decimal(10, 2)   // selling price in GHS
  compareAtPrice   Decimal?  @db.Decimal(10, 2)   // "was" price for showing deals
  images           String[]                        // array of Cloudinary URLs
  stockType        StockType @default(PREORDER)
  deliveryEstimate String    @default("10-12 days") // shown to customer
  isActive         Boolean   @default(true)        // show/hide without deleting
  isFeatured       Boolean   @default(false)       // show on homepage
  hasVariants      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category   Category          @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([categoryId])
  @@index([slug])
}

enum StockType {
  PREORDER   // sourced from China on order (default)
  IN_STOCK   // future: items the client stocks locally
}

// ------------------------------------------------------------
// PRODUCT VARIANT — options within a product (colour, size, length)
// Simple products have none; products with options have variants
// ------------------------------------------------------------
model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  name            String   // e.g. "Red", "2 metres", "iPhone 15"
  priceAdjustment Decimal  @default(0) @db.Decimal(10, 2) // +/- on base price
  sku             String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0) // order the owner listed them in

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

// ------------------------------------------------------------
// ADDRESS — saved delivery addresses (Ghana-practical)
// ------------------------------------------------------------
model Address {
  id        String   @id @default(cuid())
  userId    String?  // optional — guests don't save
  fullName  String
  phone     String
  city      String   // Accra | Kumasi | Cape Coast | Takoradi
  area      String   // neighbourhood / suburb
  landmark  String?  // "near the blue kiosk" — very Ghana-practical
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ------------------------------------------------------------
// DELIVERY ZONE — cities and their fees (admin-editable)
// ------------------------------------------------------------
model DeliveryZone {
  id            String  @id @default(cuid())
  city          String  @unique
  deliveryFee   Decimal @db.Decimal(10, 2)
  estimatedDays String  @default("1-2 days after arrival")
  isPickup      Boolean @default(false) // free pickup location
  isActive      Boolean @default(true)
}

// ------------------------------------------------------------
// CART + CART ITEM — the shopping cart (guests + users)
// ------------------------------------------------------------
model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique // logged-in user
  sessionId String?  @unique // guest browser identifier
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int     @default(1)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([cartId])
}

// ------------------------------------------------------------
// ORDER + ORDER ITEM — placed orders
// OrderItems store SNAPSHOTS (name + price at time of order)
// so order history never changes if a product is later edited
// ------------------------------------------------------------
model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique // human-friendly e.g. "NTD-0001"

  // Customer — either a registered user OR a guest
  userId     String?
  guestName  String?
  guestEmail String?
  guestPhone String?

  // Delivery — snapshot of where it's going
  addressId       String?
  deliveryCity    String
  deliveryArea    String
  deliveryLandmark String?

  // Money
  subtotal       Decimal  @db.Decimal(10, 2)
  deliveryFee    Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  couponId       String?
  total          Decimal  @db.Decimal(10, 2)

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?               @relation(fields: [userId], references: [id])
  address       Address?            @relation(fields: [addressId], references: [id])
  coupon        Coupon?             @relation(fields: [couponId], references: [id])
  items         OrderItem[]
  payment       Payment?
  statusHistory OrderStatusHistory[]

  @@index([userId])
  @@index([orderNumber])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?  // reference back (nullable if product later deleted)
  variantId   String?
  productName String   // SNAPSHOT
  variantName String?  // SNAPSHOT
  price       Decimal  @db.Decimal(10, 2) // SNAPSHOT — price actually paid
  quantity    Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

enum OrderStatus {
  PENDING    // ordered, awaiting payment
  CONFIRMED  // paid
  SOURCING   // being bought in China
  SHIPPED    // en route to Ghana
  ARRIVED    // in Ghana
  DELIVERED  // customer has it
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

// ------------------------------------------------------------
// ORDER STATUS HISTORY — timeline for customer tracking
// (builds trust during the 10-12 day wait)
// ------------------------------------------------------------
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?     // "Your order has been sourced and is being shipped"
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ------------------------------------------------------------
// PAYMENT — Paystack transaction records
// ------------------------------------------------------------
model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  reference String        @unique // Paystack transaction reference
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  status    PaymentTxnStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum PaymentMethod {
  CARD
  MOMO
}

enum PaymentTxnStatus {
  PENDING
  SUCCESS
  FAILED
}

// ------------------------------------------------------------
// COUPON — discount codes for promotions
// ------------------------------------------------------------
model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique // e.g. "NTEMTEM10"
  type           CouponType
  value          Decimal    @db.Decimal(10, 2) // 10 for 10%, or 20 for GHS 20 off
  minOrderAmount Decimal?   @db.Decimal(10, 2) // "spend GHS 100 to use"
  maxUses        Int?       // limit total redemptions
  usedCount      Int        @default(0)
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())

  orders Order[]
}

enum CouponType {
  PERCENTAGE
  FIXED
}
